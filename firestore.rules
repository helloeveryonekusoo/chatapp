rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isMember(roomId) {
      return signedIn()
        && request.auth.uid in get(/databases/$(database)/documents/rooms/$(roomId)).data.members;
    }

    // 表示名など
    match /profiles/{uid} {
      allow read:  if signedIn();
      allow write: if signedIn() && request.auth.uid == uid;
    }

    match /rooms/{roomId} {
      // get: 参加コードを知っている人が参加前に存在確認できるようにする
      allow get:  if signedIn();
      // list: 自分が参加しているプロジェクトだけ一覧に出る
      allow list: if signedIn() && request.auth.uid in resource.data.members;

      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.members == [request.auth.uid]
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 60;

      allow update: if signedIn() && (
        // 参加時の members 追加（自分自身を追加する場合に限る）
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
          && request.resource.data.members.hasAll(resource.data.members)
          && request.resource.data.members.hasOnly(resource.data.members.concat([request.auth.uid]))
        )
        ||
        // 未読判定に使う最終更新の記録（メンバーが自分名義で書く場合に限る）
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastAt', 'lastBy'])
          && request.auth.uid in resource.data.members
          && request.resource.data.lastAt == request.time
          && request.resource.data.lastBy == request.auth.uid
        )
      );

      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isMember(roomId);

        allow create: if isMember(roomId)
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 2000
          // 本文が空でも、ファイルが付いていれば通す
          && (request.resource.data.text.size() > 0 || 'file' in request.resource.data)
          && request.resource.data.createdAt == request.time;

        // 記録の書き換えは不可
        allow update, delete: if false;
      }

      // 添付ファイルの実体。ログ本体を軽く保つため別に置いている
      match /files/{fileId} {
        allow read: if isMember(roomId);

        allow create: if isMember(roomId)
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 260
          && request.resource.data.data is string
          // base64 化した実体。Firestore の 1MiB 制限に収まる範囲に抑える
          && request.resource.data.data.size() <= 950000
          && request.resource.data.createdAt == request.time;

        allow update, delete: if false;
      }
    }
  }
}
